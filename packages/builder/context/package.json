{
  "name": "@blog/context",
  "description": "blog's context package",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./*": {
      "import": "./src/*/index.ts",
      "types": "./src/*/index.ts",
      "require": "./src/*/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern --no-quiet --max-warnings=0 src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern --no-quiet --max-warnings=0 src/**/*.{ts,tsx,js,jsx}",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/blog"
  },
  "dependencies": {
    "@blog/node": "workspace:*",
    "@blog/types": "workspace:*",
    "@xiao-ai/utils": "1.6.7",
    "react": "18.3.1",
    "tapable": "2.2.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@blog/eslint-config": "workspace:*",
    "@blog/tsconfig": "workspace:*",
    "@types/node": "24.12.2",
    "@types/react": "18.3.27",
    "eslint": "10.2.1",
    "typescript": "6.0.3"
  }
}
