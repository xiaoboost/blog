{
  "name": "@blog/styles",
  "version": "1.0.0",
  "description": "blog's styles lib",
  "exports": {
    ".": {
      "types": "./src/common/index.ts",
      "import": "./src/common/index.ts",
      "require": "./src/common/index.ts"
    },
    "./common": {
      "import": "./src/common/index.ts",
      "require": "./src/common/index.ts",
      "types": "./src/common/index.ts"
    },
    "./common/*": {
      "types": [
        "./src/common/*",
        "./src/common/*.ts"
      ],
      "import": [
        "./src/common/*",
        "./src/common/*.ts"
      ],
      "require": [
        "./src/common/*",
        "./src/common/*.ts"
      ]
    },
    "./compile": {
      "types": "./src/compile/index.ts",
      "import": "./src/compile/index.ts",
      "require": "./src/compile/index.ts"
    },
    "./compile/*": {
      "types": [
        "./src/compile/*",
        "./src/compile/*.ts"
      ],
      "import": [
        "./src/compile/*",
        "./src/compile/*.ts"
      ],
      "require": [
        "./src/compile/*",
        "./src/compile/*.ts"
      ]
    },
    "./fonts/*": {
      "import": [
        "./src/fonts/*"
      ]
    }
  },
  "scripts": {
    "test": "mocha",
    "lint": "eslint --quiet src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --quiet --fix src/**/*.{ts,tsx,js,jsx}",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@blog/eslint-config": "workspace:*",
    "@blog/test-toolkit": "workspace:*",
    "@blog/tsconfig": "workspace:*",
    "@types/color": "3.0.6",
    "@types/node": "24.12.2",
    "csstype": "^3.2.3",
    "eslint": "10.2.1",
    "mocha": "10.8.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@blog/context": "workspace:*",
    "@xiao-ai/utils": "1.6.7",
    "color": "4.2.3",
    "tslib": "2.8.1"
  }
}
