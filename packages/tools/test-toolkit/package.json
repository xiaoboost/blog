{
  "name": "@blog/test-toolkit",
  "description": "blog's test toolkit",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "watch": "npm run build -- -w",
    "lint": "eslint --quiet src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --quiet --fix src/**/*.{ts,tsx,js,jsx}",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/blog"
  },
  "devDependencies": {
    "@blog/eslint-config": "workspace:*",
    "@blog/tsconfig": "workspace:*",
    "@types/blog": "workspace:*",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "24.12.2",
    "chai": "4.4.1",
    "eslint": "10.2.1",
    "tslib": "2.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@blog/context": "workspace:*",
    "@xiao-ai/utils": "1.6.7"
  }
}
