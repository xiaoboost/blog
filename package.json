{
  "name": "blog",
  "version": "5.5.3",
  "packageManager": "pnpm@12.6.0",
  "description": "个人博客",
  "author": "xiaoboost",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/blog"
  },
  "scripts": {
    "build:prepare": "pnpm run --filter @blog/cli... build",
    "build": "blog build --outDir=dist --mode=production",
    "build:debug": "pnpm run build --debug",
    "serve": "sirv --host -p 9999 -G dist",
    "static:serve": "pnpm run build:prepare && pnpm run build && pnpm run serve",
    "watch": "blog watch --hmr --mode=development --port=5173",
    "watch:debug": "pnpm run watch --debug",
    "test": "pnpm run -r --parallel test",
    "lint": "pnpm run -r --parallel lint --no-error-on-unmatched-pattern --no-quiet --max-warnings=0",
    "lint:fix": "pnpm run -r --parallel lint:fix --no-error-on-unmatched-pattern --no-quiet --max-warnings=0",
    "type-check": "pnpm run -r --parallel type-check"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.6.0 <13"
  },
  "devDependencies": {
    "@blog/cli": "workspace:*",
    "sirv-cli": "3.0.1"
  }
}
